PORT=4000
SESSION_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Customer-facing storefront (separate session scope from admin)
CUSTOMER_SESSION_SECRET=change-this-to-a-different-long-random-string

# Stripe test-mode keys — from https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Optional — only needed if you run `stripe listen --forward-to` locally
STRIPE_WEBHOOK_SECRET=whsec_...

# Order status emails — optional. Without these, emails are written to
# backend/.tmp/emails/ instead of being sent (safe for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ennys <hello@ennys.co.uk>
